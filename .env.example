# Copy this file to .env.local and fill in the values (see docs/SUPABASE_SETUP.md).
# .env.local is never committed.

# "demo" shows built-in sample content and switches the admin off. "supabase" uses the database.
NEXT_PUBLIC_DATA_MODE=demo

# Supabase > Project Settings > API. Use the PUBLISHABLE (anon) key, never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public address of the site, used for the sitemap, canonical links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
